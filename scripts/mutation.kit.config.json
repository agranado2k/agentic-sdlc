{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
  "mutate": [
    "scripts/docs-conformance/validators/*.mjs"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test scripts/docs-conformance/test/*.test.mjs"
  },
  "coverageAnalysis": "off",
  "reporters": [
    "clear-text",
    "progress"
  ],
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 60000,
  "concurrency": 4,
  "inPlace": true,
  "ignorePatterns": [
    "worktree",
    "node_modules",
    ".stryker-tmp",
    "reports"
  ]
}
